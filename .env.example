# Backloggd username (from your profile URL: backloggd.com/u/YOUR_USERNAME/)
BACKLOGGD_USERNAME=

# Backloggd password (used for automatic login when syncing to Backloggd)
BACKLOGGD_PASSWORD=

# Steam Web API key (get one at: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Your Steam ID (64-bit). Find it at: https://steamid.io/
STEAM_ID=
